def sanitize_for_path(name):
    """
    Sanitize a name for use in S3 paths.
    Replaces spaces and special characters with underscores.
    Example: "Colton Herta" -> "Colton_Herta"
    """
    return re.sub(r'[^0-9a-zA-Z._-]', '_', name)

