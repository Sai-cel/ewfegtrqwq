    return files


def get_opensearch_total_count(session_id):
    """
    Get total transcription count from OpenSearch for a session.
    Returns just the total count (not per-driver) for efficiency.
    Use S3 transcription folder for per-driver counts.
    """
    try:
        payload = {
            "query": {
                "bool": {"should": [
                    {"term": {"SessionId": session_id}},
                    {"term": {"SessionId.keyword": session_id}}
                ], "minimum_should_match": 1}
            }
        }

        credentials = base64.b64encode(f"{OPENSEARCH_USERNAME}:{OPENSEARCH_PASSWORD}".encode()).decode()
        url = f"{OPENSEARCH_URL}/{OPENSEARCH_INDEX}/_count"

        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode(),
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Basic {credentials}"
            },
            method="POST"
        )

        res = urllib.request.urlopen(req)
        data = json.loads(res.read().decode())

        total_count = data.get('count', 0)
        print(f"OpenSearch total count for session {session_id}: {total_count}")

        return total_count

    except urllib.error.HTTPError as e:
        error_body = e.read().decode() if e.fp else ''
        print(f"OpenSearch HTTP error: {e.code} - {e.reason}")
        print(f"Error body: {error_body}")
        return 0
    except Exception as e:
        print(f"Error getting OpenSearch count: {e}")
        return 0


def get_dynamodb_total_count(session_id):
    """
    Get total transcription count from DynamoDB for a session.
    Uses Query with SessionId partition key for efficiency.
    """
    try:
        transcriptions_table = dynamodb.Table(TEXTHASH_TABLE)

        response = transcriptions_table.query(
            KeyConditionExpression=Key('SessionId').eq(session_id),
            Select='COUNT'
        )

        total_count = response.get('Count', 0)

        while 'LastEvaluatedKey' in response:
            response = transcriptions_table.query(
                KeyConditionExpression=Key('SessionId').eq(session_id),
                Select='COUNT',
                ExclusiveStartKey=response['LastEvaluatedKey']
            )
            total_count += response.get('Count', 0)

        print(f"DynamoDB total count for session {session_id}: {total_count}")
        return total_count

    except Exception as e:
        print(f"Error getting DynamoDB count: {e}")
        return 0


