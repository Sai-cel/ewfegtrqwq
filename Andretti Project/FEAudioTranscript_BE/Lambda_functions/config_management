def handle_transcriptions(event, method):
    """
    Get transcriptions for a session from OpenSearch

    Query Parameters:
    - session_id (required): The session ID to get transcriptions for
    - driver_id (optional): Filter by driver ID
    - search (optional): Search text in messages
    - limit (optional): Max results (default 1000)

    Example:
    GET /transcriptions?session_id=2025-01-01_practice
    GET /transcriptions?session_id=2025-01-01_practice&driver_id=driver01
    GET /transcriptions?session_id=2025-01-01_practice&search=box
    """
    if method != 'GET':
        return response(405, {'error': 'Method not allowed'})

    try:
        params = event.get('queryStringParameters') or {}
        session_id = params.get('session_id')
        driver_id = params.get('driver_id')
        search_text = params.get('search')
        # DEFAULT WAS 1000, which silently truncated long sessions: a 30-minute
        # race across 8 drivers produces ~1360 messages, so the API returned
        # `total: 1360, count: 1000` and the UI simply stopped ~7 minutes early.
        # 10000 is OpenSearch's own default max_result_window ceiling.
        limit = int(params.get('limit', 10000))
        limit = max(1, min(limit, 10000))

        if not session_id:
            return response(400, {'error': 'session_id is required'})
        # Match the id whether SessionId/DriverId is mapped as keyword or as
        # text-with-a-.keyword-subfield (dynamic mapping). A plain term on a
        # text field returns nothing, so we OR both the field and its .keyword.
        must_clauses = [
            {"bool": {"should": [
                {"term": {"SessionId": session_id}},
                {"term": {"SessionId.keyword": session_id}}
            ], "minimum_should_match": 1}}
        ]

        if driver_id:
            must_clauses.append({"bool": {"should": [
                {"term": {"DriverId": driver_id}},
                {"term": {"DriverId.keyword": driver_id}}
            ], "minimum_should_match": 1}})

        if search_text:
            must_clauses.append({"match": {"Message": search_text}})

        payload = {
            "query": {
                "bool": {
                    "must": must_clauses
                }
            },
            "size": limit,
            "sort": [{"Timestamp": {"order": "asc"}}]
        }

        print(f"OpenSearch query: {json.dumps(payload)}")

        credentials = base64.b64encode(f"{OPENSEARCH_USERNAME}:{OPENSEARCH_PASSWORD}".encode()).decode()
        url = f"{OPENSEARCH_URL}/{OPENSEARCH_INDEX}/_search"

        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode(),
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Basic {credentials}"
            },
            method="POST"
        )

        res = urllib.request.urlopen(req)
        data = json.loads(res.read().decode())
        hits = data.get("hits", {}).get("hits", [])
        total = data.get("hits", {}).get("total", {}).get("value", len(hits))

        print(f"OpenSearch returned {len(hits)} hits (total: {total})")
        if total > len(hits):
            print(f"[TRANSCRIPTIONS] TRUNCATED - {total - len(hits)} messages NOT returned "
                  f"(limit={limit}). The UI will be missing the end of this session.")

        prerace_buffer = 0
        started_at = 0
        race_start_ts = 0
        try:
            from datetime import datetime as _dt
            session_config_table = dynamodb.Table(os.environ.get('SESSION_TABLE', 'v2_SessionConfig'))
            session_item = session_config_table.get_item(
                Key={'session_id': session_id},
                ConsistentRead=True
            ).get('Item') or {}
            if session_item.get('started_at'):
                started_at = int(session_item['started_at'])
            if session_item.get('start_time'):
                race_start_ts = int(
                    _dt.fromisoformat(
                        str(session_item['start_time']).replace('Z', '+00:00')
                    ).timestamp()
                )
        except Exception as e:
            print(f"[TRANSCRIPTIONS] SessionConfig lookup failed ({e}); trying ActiveSessions")

        if not started_at or not race_start_ts:
            try:
                active_sessions_table = dynamodb.Table(os.environ.get('ACTIVE_SESSIONS_TABLE', 'v2_ActiveSessions'))
                active_item = active_sessions_table.get_item(
                    Key={'SessionId': session_id},
                    ConsistentRead=True
                ).get('Item') or {}
                if not started_at:
                    started_at = int(active_item.get('StartedAt', 0) or 0)
                if not race_start_ts:
                    race_start_ts = int(active_item.get('RaceStartAt', 0) or 0)
            except Exception as e:
                print(f"[TRANSCRIPTIONS] ActiveSessions lookup failed ({e})")

        if started_at and race_start_ts:
            prerace_buffer = race_start_ts - started_at
        print(f"[TRANSCRIPTIONS] session_id={session_id}, started_at={started_at}, race_start_ts={race_start_ts}, prerace_buffer={prerace_buffer}")

        def format_race_relative(stored_session_time):
            """Convert stored MM:SS / HH:MM:SS (seconds since ECS start) to race-relative
            [-]MM:SS or [-]HH:MM:SS. Returns '00:00' when input is missing/unparseable."""
            if not stored_session_time:
                return "00:00"
            try:
                parts = list(map(int, str(stored_session_time).split(":")))
            except (ValueError, AttributeError):
                return str(stored_session_time)
            if len(parts) == 2:
                raw_seconds = parts[0] * 60 + parts[1]
            elif len(parts) == 3:
                raw_seconds = parts[0] * 3600 + parts[1] * 60 + parts[2]
            else:
                return str(stored_session_time)
            delta = raw_seconds - prerace_buffer
            sign = "-" if delta < 0 else ""
            abs_delta = abs(delta)
            hours = abs_delta // 3600
            minutes = (abs_delta % 3600) // 60
            seconds = abs_delta % 60
            if hours > 0:
                return f"{sign}{hours:02d}:{minutes:02d}:{seconds:02d}"
            return f"{sign}{minutes:02d}:{seconds:02d}"

        transcriptions = []
        for hit in hits:
            src = hit.get("_source", {})


            audio_url = None
            audio_s3_path = src.get("AudioS3Path", "")
            if audio_s3_path and audio_s3_path.startswith("s3://"):
                try:
                    s3_parts = audio_s3_path.replace("s3://", "").split("/", 1)
                    if len(s3_parts) == 2:
                        bucket = s3_parts[0]
                        key = s3_parts[1]
                        audio_url = s3_client.generate_presigned_url(
                            "get_object",
                            Params={"Bucket": bucket, "Key": key},
                            ExpiresIn=43200
                        )
                except Exception as e:
                    print(f"Error generating presigned URL for {audio_s3_path}: {e}")
                    audio_url = None

            transcriptions.append({
                "id": hit.get("_id"),
                "session_id": src.get("SessionId"),
                "driver_id": src.get("DriverId"),
                "driver": src.get("Driver"),
                "team": src.get("Team"),
                "speaker": src.get("Speaker"),
                "session_time": format_race_relative(src.get("SessionTime")),
                "message": src.get("Message"),
                "segments": src.get("Segments", []),
                "confidence": src.get("OverallConfidence"),
                "audio_url": audio_url,
                "audio_s3_path": audio_s3_path,
                "source_file": src.get("SourceFile"),
                "timestamp": src.get("Timestamp")
            })

        return response(200, {
            "session_id": session_id,
            "total": total,
            "count": len(transcriptions),
            "transcriptions": transcriptions
        })

    except urllib.error.HTTPError as e:
        error_body = e.read().decode() if e.fp else str(e)
        print(f"OpenSearch HTTP error: {e.code} - {error_body}")
        return response(500, {'error': f'OpenSearch error: {e.code}'})
    except Exception as e:
        print(f"Error getting transcriptions: {str(e)}")
        return response(500, {'error': str(e)})



# The ingester writes one continuous recording per driver directly to
# full-race-recordings/<session>/<DRIVER>/full_session.mp3
# (was "full-sessions/" + "_full_audio.mp3", from the old merge-based design
# that no longer runs - which is why this endpoint always returned 404).
FULL_SESSIONS_PREFIX = "full-race-recordings/"
UPLOAD_MERGED_AUDIO_PREFIX = os.environ.get("UPLOAD_MERGED_AUDIO_PREFIX", "merged-audio/")  # upload-flow full audio, written by v2_audio_merge_lambda when invoked with flow=upload
FULL_AUDIO_FILENAME = "full_session.mp3"


def handle_full_audio(event, method):
    """
    Handle full session audio requests

    Endpoints:
    1. GET /full-audio?session_id=xxx
       - List all drivers with full audio available for a session

    2. GET /full-audio?session_id=xxx&driver_id=yyy
       - Get presigned download URL for a specific driver's full audio

    3. POST /full-audio (with body: {"session_id": "xxx", "driver_ids": ["a", "b"]})
       - Trigger audio merge for specific drivers (or all if driver_ids not provided)
       - This invokes the audio_merge_lambda

    Response for GET with driver_id:
    {
        "session_id": "2025-01-01_practice",
        "driver_id": "driver01",
        "available": true,
        "download_url": "https://...",
        "expires_in": 43200
    }

    Response for GET without driver_id (list):
    {
        "session_id": "2025-01-01_practice",
        "available_drivers": ["driver01", "driver02", ...],
        "total": 5
    }
    """

    if method == 'GET':
        return handle_get_full_audio(event)
    elif method == 'POST':
        return handle_trigger_merge(event)
    else:
        return response(405, {'error': 'Method not allowed. Use GET to download or POST to trigger merge.'})


def handle_get_full_audio(event):
    """Handle GET requests for full audio download/listing"""
    params = event.get('queryStringParameters') or {}
    session_id = params.get('session_id')
    driver_id = params.get('driver_id')

    if not session_id:
        return response(400, {'error': 'session_id is required'})

    if driver_id:
        return get_full_audio_download_url(session_id, driver_id)
    else:
        return list_available_full_audios(session_id)


def get_full_audio_download_url(session_id, driver_id):
    """Generate presigned URL for downloading full session audio.

    Live flow: fixed path/filename, checked first - UNCHANGED behavior for
    every existing live session.

    Upload flow: v2_audio_merge_lambda writes uploads' merged audio under
    UPLOAD_MERGED_AUDIO_PREFIX instead (see check_stale_upload_sessions in
    v2_session_scheduler_lambda, which passes "flow": "upload"). That folder
    has more than one filename pattern already in real use
    ({driver}_merged.mp3 from older data, {session}_{driver}_full_audio.mp3
    from newer runs), so rather than guess one convention, this lists the
    folder and takes whatever .mp3 is there. This fallback only runs when
    the live path has nothing - it never changes what live sessions see.
    """
    output_key = f"{FULL_SESSIONS_PREFIX}{session_id}/{driver_id}/{FULL_AUDIO_FILENAME}"
    try:
        try:
            s3_client.head_object(Bucket=S3_BUCKET, Key=output_key)
            filename = f"{driver_id}_full_session.mp3"
        except Exception:
            upload_prefix = f"{UPLOAD_MERGED_AUDIO_PREFIX}{session_id}/{driver_id}/"
            try:
                listing = s3_client.list_objects_v2(Bucket=S3_BUCKET, Prefix=upload_prefix)
                mp3_candidates = [
                    obj for obj in listing.get('Contents', [])
                    if obj['Key'].lower().endswith('.mp3')
                ]
            except Exception:
                mp3_candidates = []

            if not mp3_candidates:
                return response(404, {
                    "session_id": session_id,
                    "driver_id": driver_id,
                    "available": False,
                    "error": "Full audio not available yet (session may still be running)."
                })

            output_key = mp3_candidates[0]['Key']
            filename = os.path.basename(output_key)

        url = s3_client.generate_presigned_url(
            "get_object",
            Params={"Bucket": S3_BUCKET, "Key": output_key},
            ExpiresIn=43200
        )
        return response(200, {
            "session_id": session_id,
            "driver_id": driver_id,
            "available": True,
            "download_url": url,
            "filename": filename,
            "expires_in": 43200,
            "expires_in_hours": 12
        })
    except Exception as e:
        print(f"Error getting full audio URL: {str(e)}")
        return response(500, {'error': str(e)})

def list_available_full_audios(session_id):
    """List all drivers that have full audio available for a session"""
    prefix = f"{FULL_SESSIONS_PREFIX}{session_id}/"

    try:
        response_data = s3_client.list_objects_v2(
            Bucket=S3_BUCKET,
            Prefix=prefix,
            Delimiter='/'
        )

        drivers = []
        for prefix_info in response_data.get('CommonPrefixes', []):
            driver_prefix = prefix_info['Prefix']
            driver_id = driver_prefix.replace(prefix, '').rstrip('/')
            if driver_id:
                drivers.append(driver_id)

        return response(200, {
            "session_id": session_id,
            "available_drivers": drivers,
            "total": len(drivers)
        })

    except Exception as e:
        print(f"Error listing full audios: {str(e)}")
        return response(500, {'error': str(e)})


def handle_trigger_merge(event):
    """
    Trigger audio merge for a session

    Request body:
    {
        "session_id": "2025-01-01_practice",
        "driver_ids": ["driver01", "driver02"]  // Optional - if not provided, merges all drivers
    }
    """
    try:
        body = json.loads(event.get('body', '{}'))
        session_id = body.get('session_id')
        driver_ids = body.get('driver_ids')

        if not session_id:
            return response(400, {'error': 'session_id is required'})

        lambda_client = boto3.client('lambda')

        payload = {
            "session_id": session_id
        }
        if driver_ids:
            payload["driver_ids"] = driver_ids

        merge_lambda_name = os.environ.get('AUDIO_MERGE_LAMBDA', 'v2-audio-merge-lambda')

        print(f"Invoking {merge_lambda_name} with payload: {json.dumps(payload)}")

        lambda_client.invoke(
            FunctionName=merge_lambda_name,
            InvocationType='Event',
            Payload=json.dumps(payload)
        )

        return response(202, {
            "message": "Audio merge triggered successfully",
            "session_id": session_id,
            "driver_ids": driver_ids if driver_ids else "all",
            "status": "processing",
            "note": "Use GET /full-audio?session_id=xxx to check availability"
        })

    except json.JSONDecodeError:
        return response(400, {'error': 'Invalid JSON body'})
    except Exception as e:
        print(f"Error triggering merge: {str(e)}")
        return response(500, {'error': str(e)})



