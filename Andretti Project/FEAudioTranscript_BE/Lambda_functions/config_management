def _truthy(value):
    return str(value).strip().lower() in ('true', '1', 'yes', 'on')


def should_show_test_drivers(toggle_value):
    """Decide whether test drivers should be visible.

    Default is ON (shown) — test drivers are enabled unless the toggle is
    explicitly turned off (show_test_drivers=false). In production, the
    HIDE_TEST_DRIVERS_IN_PROD option (off by default) can force them hidden
    regardless of the toggle."""
    if IS_PRODUCTION and HIDE_TEST_DRIVERS_IN_PROD:
        return False
    if toggle_value is None or str(toggle_value).strip() == '':
        return True
    return _truthy(toggle_value)


def get_created_by(data):
    """Resolve the acting login user from the request body.

    The frontend sends `created_by` (the logged-in user's username/email).
    Falls back to 'unknown' so a missing field never blocks the request."""
    if isinstance(data, dict):
        actor = data.get('created_by') or data.get('username')
        if actor:
            return str(actor).strip()
    return 'unknown'


def record_audit_event(action, entity, entity_id, created_by, details=None):
    """Write an audit-trail record to S3 as a single JSON object, in three
    places:
      * {prefix}YYYY/MM/DD/{action}_{epoch}_{id}.json  - date partition
        (original layout, unchanged; this app's own /audit-logs endpoint
        reads from here).
      * session_logs/{session_id}/{action}_{epoch}_{id}.json  - for
        session-scoped events (entity in SESSION_SCOPED_ENTITIES), so "every
        event for session X" is one S3 ListObjectsV2 prefix call.
      * system_logs/YYYY/MM/DD/{action}_{epoch}_{id}.json  - for everything
        else (auth, websocket connections, driver/team/keywords config).

    No-op if AUDIT_S3_BUCKET is not configured. Never raises — audit logging
    must not break the primary request flow."""
    if not AUDIT_S3_BUCKET:
        return
    try:
        now = datetime.utcnow()
        record = {
            'audit_id': str(uuid.uuid4()),
            'timestamp': now.isoformat() + 'Z',
            'action': action,
            'entity': entity,
            'entity_id': str(entity_id) if entity_id is not None else '',
            'created_by': created_by or 'unknown',
            'details': details or {}
        }
        suffix = f"{action}_{int(now.timestamp())}_{record['audit_id'][:8]}.json"
        body = json.dumps(record, default=str).encode('utf-8')
        date_path = now.strftime('%Y/%m/%d')
        s3_client.put_object(
            Bucket=AUDIT_S3_BUCKET,
            Key=f"{AUDIT_S3_PREFIX}{date_path}/{suffix}",
            Body=body,
            ContentType='application/json'
        )
        if entity in SESSION_SCOPED_ENTITIES and record['entity_id']:
            s3_client.put_object(
                Bucket=AUDIT_S3_BUCKET,
                Key=f"{SESSION_LOGS_PREFIX}{record['entity_id']}/{suffix}",
                Body=body,
                ContentType='application/json'
            )
        else:
            s3_client.put_object(
                Bucket=AUDIT_S3_BUCKET,
                Key=f"{SYSTEM_LOGS_PREFIX}{date_path}/{suffix}",
                Body=body,
                ContentType='application/json'
            )
    except Exception as e:
        print(f"[AUDIT] Failed to record {action} for {entity}:{entity_id}: {e}")


def is_test_driver(driver):
    """True if this driver is a test/dummy driver that must be hidden in
    production. Matches an explicit is_test flag, or 'test' in the id/name."""
    if not isinstance(driver, dict):
        return False
    if str(driver.get('is_test', '')).strip().lower() in ('true', '1', 'yes'):
        return True
    ident = f"{driver.get('driver_id', '')} {driver.get('driver_name', '')}".lower()
    return 'test' in ident


