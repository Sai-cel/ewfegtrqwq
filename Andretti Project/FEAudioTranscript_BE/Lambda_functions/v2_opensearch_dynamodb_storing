def get_base_offset_from_filename(media_filename):
    """
    Extract time offset from filename.
    Supports both old and new formats:
    - New: segment-00234-39m00s.mp3 -> 2340 seconds
    - Old: segment-00001.mp3 -> 10 seconds (based on SEGMENT_TIME_SECONDS)
    """
    match_time = re.search(r'-(\d+)m(\d+)s', media_filename)
    if match_time:
        try:
            minutes = int(match_time.group(1))
            seconds = int(match_time.group(2))
            return (minutes * 60) + seconds
        except ValueError:
            pass

    match_seq = re.search(r'segment-(\d+)', media_filename)
    if match_seq:
        try:
            return int(match_seq.group(1)) * SEGMENT_TIME_SECONDS
        except ValueError:
            return 0
    return 0


def get_leading_silence_for_chunk(bucket, key):
    """Seconds of silence the silence-removal step trimmed from the FRONT of
    this chunk, read from the cleaned object's S3 metadata.

    WHY THIS EXISTS: Transcribe runs on the SILENCE-REMOVED audio, so it always
    reports speech starting at ~0.0s. Adding that to the chunk's base offset put
    every message exactly on the 10-second boundary (00:25, 00:35 ...), which is
    why every driver appeared to speak at the same instant. Adding back the
    trimmed leading silence restores the real moment the driver spoke.

    Returns 0.0 if the metadata is absent (e.g. chunk processed before this
    change), which reproduces the old behaviour rather than failing.
    """
    try:
        head = s3_client.head_object(Bucket=bucket, Key=key)
        raw = (head.get("Metadata") or {}).get("leading-silence")
        if raw is None:
            return 0.0
        return max(0.0, float(raw))
    except Exception as e:
        print(f"[SPEECH_TIME] Could not read leading-silence for {key}: {e}")
        return 0.0


def format_timestamp(seconds_str, base_offset_seconds=0):
    """Format seconds into MM:SS timestamp"""
    try:
        local_seconds = float(seconds_str)
        global_seconds = base_offset_seconds + local_seconds
        minutes = int(global_seconds // 60)
        secs = int(global_seconds % 60)
        return f"{minutes:02d}:{secs:02d}"
    except:
        return "00:00"


def format_race_relative_time(stored_session_time, prerace_buffer=0):
    """Convert stored MM:SS / HH:MM:SS (seconds since ECS start) to race-relative
    [-]MM:SS or [-]HH:MM:SS. Conversations before the actual race start are
    prefixed with '-' (e.g. '-00:30'); at/after race start they are positive
    (e.g. '00:00', '01:15'). Returns '00:00' for missing input."""
    if not stored_session_time:
        return "00:00"
    try:
        parts = list(map(int, str(stored_session_time).split(":")))
    except (ValueError, AttributeError):
        return str(stored_session_time)
    if len(parts) == 2:
        raw_seconds = parts[0] * 60 + parts[1]
    elif len(parts) == 3:
        raw_seconds = parts[0] * 3600 + parts[1] * 60 + parts[2]
    else:
        return str(stored_session_time)
    delta = raw_seconds - prerace_buffer
    sign = "-" if delta < 0 else ""
    abs_delta = abs(delta)
    hours = abs_delta // 3600
    minutes = (abs_delta % 3600) // 60
    seconds = abs_delta % 60
    if hours > 0:
        return f"{sign}{hours:02d}:{minutes:02d}:{seconds:02d}"
    return f"{sign}{minutes:02d}:{seconds:02d}"


def session_time_to_seconds(stored_session_time):
    """Parse a stored SessionTime ('MM:SS' or 'HH:MM:SS', possibly signed like
    '-01:30') into total seconds. Sign-safe: a leading '-' negates the whole
    value, unlike int('-00') which silently drops the sign and is what made the
    race conversation order by magnitude (13, -17, 23, -27, ...) instead of by
    signed race time."""
    if not stored_session_time:
        return 0
    s = str(stored_session_time).strip()
    negative = s.startswith('-')
    if negative:
        s = s[1:]
    try:
        parts = [int(p) for p in s.split(':')]
    except (ValueError, AttributeError):
        return 0
    if len(parts) == 2:
        total = parts[0] * 60 + parts[1]
    elif len(parts) == 3:
        total = parts[0] * 3600 + parts[1] * 60 + parts[2]
    else:
        return 0
    return -total if negative else total


def get_text_hash(text, session_time):
    """
    Generate MD5 hash of text + session time for deduplication.
    Allows same phrase at different times but catches true duplicates.
    """
    normalized = text.lower().strip()
    normalized = ' '.join(normalized.split())
    content = f"{normalized}|{session_time}"
    return hashlib.md5(content.encode()).hexdigest()


