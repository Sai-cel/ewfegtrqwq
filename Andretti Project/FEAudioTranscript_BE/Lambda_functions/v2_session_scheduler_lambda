def get_created_by(data):
    """Resolve the acting login user from the request body.

    The frontend sends `created_by` (the logged-in user's username/email).
    Falls back to 'unknown' so a missing field never blocks the request."""
    if isinstance(data, dict):
        actor = data.get('created_by') or data.get('username')
        if actor:
            return str(actor).strip()
    return 'unknown'


def actor_from_event(event):
    """Best-effort extraction of the acting user for requests that may not pass
    a parsed body (DELETE/start/stop). Checks body then query string."""
    body = event.get('body')
    if body:
        try:
            data = json.loads(body) if isinstance(body, str) else body
            if isinstance(data, dict) and (data.get('created_by') or data.get('username')):
                return get_created_by(data)
        except Exception:
            pass
    qs = event.get('queryStringParameters') or {}
    return qs.get('created_by') or 'unknown'


# Audit trail — every session lifecycle event is written to AUDIT_S3_BUCKET
# (test-v2-andretti-audit-logs) so the full system flow is logged end to end.
def record_audit_event(action, entity, entity_id, created_by, details=None):
    """Write an audit-trail record to S3 in three places:
      * {prefix}YYYY/MM/DD/{action}_{epoch}_{id}.json  - date partition
        (original layout, unchanged; this app's own /audit-logs endpoint
        reads from here).
      * session_logs/{session_id}/{action}_{epoch}_{id}.json  - for
        session-scoped events (entity in SESSION_SCOPED_ENTITIES; this
        Lambda's SESSION_* events all qualify), so "every event for session
        X" is one S3 ListObjectsV2 prefix call.
      * system_logs/YYYY/MM/DD/{action}_{epoch}_{id}.json  - for everything
        else.

    No-op if AUDIT_S3_BUCKET is not configured. Never raises — audit logging
    must not break the primary request flow."""
    if not AUDIT_S3_BUCKET:
        return
    try:
        now = datetime.utcnow()
        record = {
            'audit_id': str(uuid.uuid4()),
            'timestamp': now.isoformat() + 'Z',
            'action': action,
            'entity': entity,
            'entity_id': str(entity_id) if entity_id is not None else '',
            'created_by': created_by or 'unknown',
            'details': details or {}
        }
        suffix = f"{action}_{int(now.timestamp())}_{record['audit_id'][:8]}.json"
        body = json.dumps(record, default=str).encode('utf-8')
        date_path = now.strftime('%Y/%m/%d')
        s3_client.put_object(
            Bucket=AUDIT_S3_BUCKET,
            Key=f"{AUDIT_S3_PREFIX}{date_path}/{suffix}",
            Body=body,
            ContentType='application/json'
        )
        if entity in SESSION_SCOPED_ENTITIES and record['entity_id']:
            s3_client.put_object(
                Bucket=AUDIT_S3_BUCKET,
                Key=f"{SESSION_LOGS_PREFIX}{record['entity_id']}/{suffix}",
                Body=body,
                ContentType='application/json'
            )
        else:
            s3_client.put_object(
                Bucket=AUDIT_S3_BUCKET,
                Key=f"{SYSTEM_LOGS_PREFIX}{date_path}/{suffix}",
                Body=body,
                ContentType='application/json'
            )
    except Exception as e:
        print(f"[AUDIT] Failed to record {action} for {entity}:{entity_id}: {e}")


def _build_utc_offsets():
    """Standard UTC offsets from -12:00 to +14:00 (including the half/quarter-hour
    zones) for the create-session dropdown."""
    raw = [
        (-12, 0), (-11, 0), (-10, 0), (-9, 30), (-9, 0), (-8, 0), (-7, 0),
        (-6, 0), (-5, 0), (-4, 0), (-3, 30), (-3, 0), (-2, 0), (-1, 0),
        (0, 0), (1, 0), (2, 0), (3, 0), (3, 30), (4, 0), (4, 30), (5, 0),
        (5, 30), (5, 45), (6, 0), (6, 30), (7, 0), (8, 0), (8, 45), (9, 0),
        (9, 30), (10, 0), (10, 30), (11, 0), (12, 0), (12, 45), (13, 0), (14, 0),
    ]
    out = []
    for h, m in raw:
        sign = '+' if h >= 0 else '-'
        value = f"UTC{sign}{abs(h):02d}:{m:02d}"
        offset_minutes = h * 60 + (m if h >= 0 else -m)
        out.append({'label': f"({value})", 'value': value,
                    'offset_minutes': offset_minutes})
    return out


UTC_OFFSETS = _build_utc_offsets()


def _parse_utc_offset(tz_name):
    """Convert a fixed UTC-offset string into a tzinfo.

    Accepts 'UTC+05:30', 'GMT-08:00', '+05:30', '-0800', 'UTC', 'UTC+00:00'.
    Returns a datetime.timezone, or None if the string isn't offset-style
    (e.g. an IANA name like 'America/New_York')."""
    if tz_name is None:
        return None
    s = str(tz_name).strip().upper()
    for prefix in ('UTC', 'GMT'):
        if s.startswith(prefix):
            s = s[len(prefix):].strip()
            break
    if s == '':
        return timezone.utc
    sign = 1
    if s[0] in '+-':
        sign = -1 if s[0] == '-' else 1
        s = s[1:]
    if ':' in s:
        hh, mm = s.split(':', 1)
    elif len(s) > 2:
        hh, mm = s[:-2], s[-2:]
    else:
        hh, mm = s, '0'
    try:
        hours, minutes = int(hh), int(mm)
    except ValueError:
        return None
    if hours > 14 or minutes >= 60:
        return None
    return timezone(sign * timedelta(hours=hours, minutes=minutes))


def parse_session_datetime(dt_str, tz_name=None):
    """Parse an ISO datetime string into a timezone-aware datetime.

    Resolution order:
      1. If the string already carries an offset ('...Z' or '+05:30'), that wins.
      2. Else if tz_name is a UTC offset ('UTC+05:30'), apply that fixed offset.
      3. Else if tz_name is an IANA name and zoneinfo is available, use it.
      4. Else treat the time as UTC.

    The result is tz-aware, so datetime_to_cron() converts it to UTC correctly
    for EventBridge regardless of the chosen offset."""
    dt = datetime.fromisoformat(str(dt_str).strip().replace('Z', '+00:00'))
    if dt.tzinfo is not None:
        return dt
    if tz_name:
        offset_tz = _parse_utc_offset(tz_name)
        if offset_tz is not None:
            return dt.replace(tzinfo=offset_tz)
        if ZoneInfo is not None:
            try:
                return dt.replace(tzinfo=ZoneInfo(tz_name))
            except Exception as e:
                print(f"[TZ] Unknown timezone '{tz_name}' ({e}); treating time as UTC")
    return dt.replace(tzinfo=timezone.utc)


def _format_offset(minutes):
    """Format signed offset minutes as a UTC label, e.g. 330 -> 'UTC+05:30'."""
    sign = '+' if minutes >= 0 else '-'
    a = abs(int(minutes))
    return f"UTC{sign}{a // 60:02d}:{a % 60:02d}"


def list_timezones():
    """Return ALL IANA timezones for the create-session dropdown, each labelled
    with its current UTC offset, sorted by offset then name, e.g.
    {'value': 'Asia/Kolkata', 'label': '(UTC+05:30) Asia/Kolkata',
     'offset_minutes': 330}.

    UTC is always included. Falls back to fixed UTC offsets if the runtime has
    no IANA tz database (add the 'tzdata' package to the deployment to avoid the
    fallback on Amazon Linux 2023 / python3.12+)."""
    if ZoneInfo is not None and available_timezones is not None:
        try:
            now = datetime.now(timezone.utc)
            zones = []
            for name in available_timezones():
                try:
                    off = now.astimezone(ZoneInfo(name)).utcoffset()
                    mins = int(off.total_seconds() // 60) if off else 0
                except Exception:
                    continue
                zones.append({
                    'value': name,
                    'label': f"({_format_offset(mins)}) {name}",
                    'offset_minutes': mins,
                })
            if zones:
                if not any(z['value'] == 'UTC' for z in zones):
                    zones.append({'value': 'UTC', 'label': '(UTC+00:00) UTC',
                                  'offset_minutes': 0})
                zones.sort(key=lambda z: (z['offset_minutes'], z['value']))
                return response(200, {'timezones': zones, 'count': len(zones)})
        except Exception as e:
            print(f"[TZ] Failed to build IANA list ({e}); falling back to UTC offsets")
    return response(200, {'timezones': UTC_OFFSETS, 'count': len(UTC_OFFSETS)})


def derive_race_name(session_name):
    """Race name defaults to the first word of the session name
    (e.g. 'Monaco GP Practice' -> 'Monaco'). Returns '' if empty."""
    if not session_name:
        return ''
    parts = str(session_name).strip().split()
    return parts[0] if parts else str(session_name).strip()


def add_schedule_columns(session):
    """Ensure a session dict carries the two race-schedule display columns:
    `race_name` (first word of session_name by default) and `created_date`
    (YYYY-MM-DD from created_at). Derived on read so existing rows that predate
    these fields still populate the columns. Does not overwrite stored values."""
    if not session.get('race_name'):
        session['race_name'] = derive_race_name(session.get('session_name', ''))
    if not session.get('created_date'):
        created_at = session.get('created_at') or ''
        session['created_date'] = created_at[:10] if created_at else ''
    if not session.get('timezone'):
        session['timezone'] = 'UTC' 
    return session


class DecimalEncoder(json.JSONEncoder):
    """Handle Decimal types from DynamoDB."""

    def default(self, obj):
        if isinstance(obj, Decimal):
            return float(obj)
        return super(DecimalEncoder, self).default(obj)


def lambda_handler(event, context):
    """Main Lambda handler."""
    print(f"Event: {json.dumps(event)}")

    if event.get('source') == 'aws.events':
        return handle_scheduled_event(event)

    http_method = event.get(
        'httpMethod',
        event.get(
            'requestContext',
            {}).get(
            'http',
            {}).get(
                'method',
            ''))
    path = event.get('path', event.get('rawPath', ''))
    path_parameters = event.get('pathParameters') or {}

    print(f"Method: {http_method}, Path: {path}")

    try:
        if '/timezones' in path:
            if http_method == 'GET':
                return list_timezones()
            return response(405, {'error': 'Method not allowed'})

        if '/sessions' in path:
            session_id = path_parameters.get(
                'session_id') or path_parameters.get('proxy', '').split('/')[-1]

            actor = actor_from_event(event)

            if path.endswith('/start') and http_method == 'POST':
                return start_session_manually(session_id.replace('/start', ''), actor)
            elif path.endswith('/stop') and http_method == 'POST':
                return stop_session_manually(session_id.replace('/stop', ''), actor)
            elif session_id and session_id != 'sessions':
                if http_method == 'GET':
                    return get_session(session_id)
                elif http_method == 'PUT':
                    return update_session(
                        session_id, json.loads(
                            event.get(
                                'body', '{}')))
                elif http_method == 'DELETE':
                    return delete_session(session_id, actor)
            else:
                if http_method == 'GET':
                    status_filter = (event.get('queryStringParameters') or {}).get('status')
                    return list_sessions(status_filter)
                elif http_method == 'POST':
                    return create_session(json.loads(event.get('body', '{}')))

        return response(400, {'error': 'Invalid request path'})

    except Exception as e:
        print(f"Error: {str(e)}")
        import traceback
        traceback.print_exc()
        return response(500, {'error': str(e)})


def handle_scheduled_event(event):
    """Handle EventBridge scheduled events for starting/stopping ECS,
    and the recurring stale-upload-session check."""
    detail = event.get('detail', {})
    action = detail.get('action')
    session_id = detail.get('session_id')

    print(f"Scheduled event - Action: {action}, Session: {session_id}")

    if action == 'START':
        return start_ecs_task(session_id, actor='scheduler')
    elif action == 'STOP':
        return stop_ecs_task(session_id, actor='scheduler')
    elif action == 'CHECK_STALE_UPLOADS':
        return check_stale_upload_sessions()
    else:
        print(f"Unknown action: {action}")
        return {'statusCode': 400, 'body': 'Unknown action'}


# --- Upload-flow completion detection ---
# Uploaded sessions have no v2_ActiveSessions entry (that table is only
# written by the live-flow ECS task), so we never get a "session stopped"
# signal for them the way live sessions do. Instead, this runs on a
# recurring EventBridge schedule (every 5 minutes) and treats an upload
# session as finished once its audit trail (session_logs/{session_id}/ in
# the audit S3 bucket - the same log stream every pipeline Lambda already
# writes to) has been quiet for STALE_UPLOAD_THRESHOLD_MINUTES. This mirrors
# exactly what stop_ecs_task() already does for live sessions: mark the
# session COMPLETED and invoke the audio-merge Lambda - just triggered by
# inactivity instead of an explicit stop signal.
STALE_UPLOAD_THRESHOLD_MINUTES = int(os.environ.get('STALE_UPLOAD_THRESHOLD_MINUTES', '5'))


def _get_last_session_activity(session_id):
    """Most recent audit-log timestamp for this session, or None if no
    logs exist yet (e.g. session just created, nothing processed)."""
    try:
        resp = s3_client.list_objects_v2(
            Bucket=AUDIT_S3_BUCKET,
            Prefix=f"{SESSION_LOGS_PREFIX}{session_id}/"
        )
        contents = resp.get('Contents', [])
        if not contents:
            return None
        return max(obj['LastModified'] for obj in contents)
    except Exception as e:
        print(f"[STALE_CHECK] Error reading session logs for {session_id}: {e}")
        return None


def check_stale_upload_sessions():
    """Scan v2_SessionConfig for upload-flow sessions (no v2_ActiveSessions
    entry) that are not yet COMPLETED, and finish any whose audit trail has
    gone quiet for STALE_UPLOAD_THRESHOLD_MINUTES."""
    from datetime import datetime as _dt, timezone as _tz

    print(f"[STALE_CHECK] Starting stale-upload-session scan (threshold={STALE_UPLOAD_THRESHOLD_MINUTES}m)")
    checked = 0
    completed = []
    errors = []

    try:
        scan_kwargs = {}
        while True:
            resp = session_table.scan(**scan_kwargs)
            for session in resp.get('Items', []):
                session_id = session.get('session_id')
                status = (session.get('status') or '').upper()
                if not session_id or status == 'COMPLETED':
                    continue

                # A session belongs to the live flow if and only if it was
                # created through the scheduler, which always sets these two
                # EventBridge rule fields (see create_session). Uploads never
                # go through that path, so they never have these fields -
                # this is true whether the live race is scheduled, currently
                # running, or already finished, unlike checking
                # v2_ActiveSessions, which is only populated once the race's
                # ECS task actually starts and wrongly looked like "not live"
                # for any race that was merely scheduled but not yet started.
                if session.get('eventbridge_start_rule') or session.get('eventbridge_stop_rule'):
                    continue

                checked += 1
                last_activity = _get_last_session_activity(session_id)
                if last_activity is None:
                    print(f"[STALE_CHECK] {session_id}: no session logs yet, skipping")
                    continue

                age_minutes = (_dt.now(_tz.utc) - last_activity).total_seconds() / 60.0
                if age_minutes < STALE_UPLOAD_THRESHOLD_MINUTES:
                    print(f"[STALE_CHECK] {session_id}: last activity {age_minutes:.1f}m ago, still recent")
                    continue

                print(f"[STALE_CHECK] {session_id}: quiet for {age_minutes:.1f}m, marking COMPLETED and triggering merge")
                try:
                    session_table.update_item(
                        Key={'session_id': session_id},
                        UpdateExpression="SET #status = :status, #updated_at = :updated_at",
                        ExpressionAttributeNames={'#status': 'status', '#updated_at': 'updated_at'},
                        ExpressionAttributeValues={
                            ':status': 'COMPLETED',
                            ':updated_at': datetime.utcnow().isoformat() + 'Z'
                        }
                    )
                    audio_merge_lambda = os.environ.get('AUDIO_MERGE_LAMBDA', 'v2_audio_merge_lambda')
                    lambda_client = boto3.client('lambda')
                    lambda_client.invoke(
                        FunctionName=audio_merge_lambda,
                        InvocationType='Event',
                        Payload=json.dumps({"session_id": session_id, "flow": "upload"})
                    )
                    record_audit_event('SESSION_STOP', 'session', session_id, 'system', {
                        'note': 'upload session completed via stale-activity detection',
                        'quiet_minutes': round(age_minutes, 1)
                    })
                    completed.append(session_id)
                except Exception as e:
                    print(f"[STALE_CHECK] Error completing {session_id}: {e}")
                    errors.append({'session_id': session_id, 'error': str(e)})

            if 'LastEvaluatedKey' in resp:
                scan_kwargs['ExclusiveStartKey'] = resp['LastEvaluatedKey']
            else:
                break
    except Exception as e:
        print(f"[STALE_CHECK] Fatal error during scan: {e}")
        return {'statusCode': 500, 'body': json.dumps({'error': str(e)})}

    print(f"[STALE_CHECK] Done. checked={checked}, completed={completed}, errors={errors}")
    return {
        'statusCode': 200,
        'body': json.dumps({'checked': checked, 'completed': completed, 'errors': errors})
    }


def resolve_drivers(data):
    """
    Resolve drivers from any of the supported formats.
    Returns (driver_snapshot, driver_ids) tuple or (None, error_response) on failure.

    Supports:
    - driver_ids: ["driver01", "driver02"] - lookup by driver_id (primary key)
    - driver_numbers: ["26", "10"] - lookup by car number
    - driver_names: ["Colton Herta", "Kyle Kirkwood"] - lookup by driver name
    """
    driver_snapshot = []

    if data.get('driver_ids'):
        driver_ids_input = data['driver_ids']
        if not isinstance(driver_ids_input, list):
            return None, response(400, {'error': 'driver_ids must be a list'})

        for driver_id in driver_ids_input:
            driver_response = driver_table.get_item(
                Key={'driver_id': driver_id})
            if 'Item' not in driver_response:
                return None, response(
                    400, {'error': f'Driver not found with id: {driver_id}'})
            driver_snapshot.append(driver_response['Item'])

    elif data.get('driver_numbers'):
        driver_numbers = data['driver_numbers']
        if not isinstance(driver_numbers, list):
            return None, response(
                400, {'error': 'driver_numbers must be a list'})

        all_drivers = driver_table.scan().get('Items', [])
        for num in driver_numbers:
            num_str = str(num)
            found = next(
                (d for d in all_drivers if str(
                    d.get(
                        'driver_number',
                        '')) == num_str),
                None)
            if not found:
                return None, response(
                    400, {'error': f'Driver not found with number: {num}'})
            driver_snapshot.append(found)

    elif data.get('driver_names'):
        driver_names = data['driver_names']
        if not isinstance(driver_names, list):
            return None, response(
                400, {'error': 'driver_names must be a list'})

        all_drivers = driver_table.scan().get('Items', [])
        for name in driver_names:
            name_lower = name.lower()
            found = next(
                (d for d in all_drivers if d.get(
                    'driver_name',
                    '').lower() == name_lower),
                None)
            if not found:
                return None, response(
                    400, {'error': f'Driver not found with name: {name}'})
            driver_snapshot.append(found)

    else:
        return None, None

    if not driver_snapshot:
        return None, response(400, {'error': 'No valid drivers found'})

    # Test drivers are always allowed and visible in the drivers list (the
    # show-test-drivers toggle has been removed).

    driver_snapshot = [{
        'driver_id': d.get('driver_id', ''),
        'driver_name': d.get('driver_name', ''),
        'driver_number': str(d.get('driver_number', '')),
        'team': d.get('team', ''),
        'stream_url': d.get('stream_url', ''),
        'driver_address': d.get('driver_address', '')
    } for d in driver_snapshot]

    driver_ids = [d['driver_id'] for d in driver_snapshot]

    return (driver_snapshot, driver_ids), None


def create_session(data):
    """Create a new session and schedule EventBridge rules.

    Accepts drivers in any of these formats:
    - driver_ids: ["driver01", "driver02"] - lookup by driver_id (primary key)
    - driver_numbers: ["26", "10"] - lookup by car number
    - driver_names: ["Colton Herta", "Kyle Kirkwood"] - lookup by driver name
    """
    if not data.get('session_name'):
        return response(400, {'error': 'Please provide a session name.'})

    if not data.get('start_time') or not data.get('end_time'):
        return response(400, {'error': 'Please provide both start and end time.'})

    has_drivers = data.get('driver_ids') or data.get(
        'driver_numbers') or data.get('driver_names')
    if not has_drivers:
        return response(400, {'error': 'Please select at least one driver.'})

    duplicate_name = find_session_name_conflict(data['session_name'])
    if duplicate_name:
        return response(400, {'error': 'A session with this name already exists.'})

    if data.get('session_id'):
        session_id = data['session_id']
    else:
        clean_name = data['session_name'].replace(' ', '_')
        clean_name = ''.join(c for c in clean_name if c.isalnum() or c == '_')

        try:
            start_dt = datetime.fromisoformat(
                data['start_time'].replace('Z', '+00:00'))
            timestamp = start_dt.strftime("%Y-%m-%d_%H-%M")
        except BaseException:
            timestamp = datetime.utcnow().strftime("%Y-%m-%d_%H-%M")

        session_id = f"{clean_name}_{timestamp}"
        print(f"Generated session_id: {session_id}")

    resolved, error = resolve_drivers(data)
    if error:
        return error
    if resolved is None:
        return response(400, {'error': 'No valid drivers found'})

    driver_snapshot, driver_ids = resolved
    print(
        f"Resolved {len(driver_snapshot)} drivers: {[d['driver_name'] for d in driver_snapshot]}")

    session_timezone = data.get('timezone') or 'UTC'
    try:
        start_dt = parse_session_datetime(data['start_time'], session_timezone)
        end_dt = parse_session_datetime(data['end_time'], session_timezone)
    except ValueError as e:
        return response(400, {'error': f'Invalid datetime format: {str(e)}'})

    if end_dt <= start_dt:
        return response(400, {'error': 'End time must be after start time.'})

    overlap_name = find_overlapping_session_name(start_dt, end_dt)
    if overlap_name:
        return response(400, {
            'error': f'Cannot create session. "{overlap_name}" is already scheduled during this time.'
        })

    start_rule_name = f"andretti-start-{session_id}"
    stop_rule_name = f"andretti-stop-{session_id}"

    try:
        start_cron = datetime_to_cron(start_dt)
        events_client.put_rule(
            Name=start_rule_name,
            ScheduleExpression=start_cron,
            State='ENABLED',
            Description=f'Start ECS for session: {session_id}'
        )

        events_client.put_targets(
            Rule=start_rule_name,
            Targets=[{
                'Id': f'start-{session_id}',
                'Arn': SCHEDULER_LAMBDA_ARN,
                'Input': json.dumps({
                    'source': 'aws.events',
                    'detail': {
                        'action': 'START',
                        'session_id': session_id
                    }
                })
            }]
        )
        grant_eventbridge_invoke_permission(start_rule_name)

        stop_cron = datetime_to_cron(end_dt)
        events_client.put_rule(
            Name=stop_rule_name,
            ScheduleExpression=stop_cron,
            State='ENABLED',
            Description=f'Stop ECS for session: {session_id}'
        )

        events_client.put_targets(
            Rule=stop_rule_name,
            Targets=[{
                'Id': f'stop-{session_id}',
                'Arn': SCHEDULER_LAMBDA_ARN,
                'Input': json.dumps({
                    'source': 'aws.events',
                    'detail': {
                        'action': 'STOP',
                        'session_id': session_id
                    }
                })
            }]
        )
        grant_eventbridge_invoke_permission(stop_rule_name)

        print(
            f"Created EventBridge rules: {start_rule_name}, {stop_rule_name}")

    except Exception as e:
        print(f"Error creating EventBridge rules: {str(e)}")
        try:
            events_client.remove_targets(
                Rule=start_rule_name, Ids=[f'start-{session_id}'])
            events_client.delete_rule(Name=start_rule_name)
        except BaseException:
            pass
        try:
            events_client.remove_targets(
                Rule=stop_rule_name, Ids=[f'stop-{session_id}'])
            events_client.delete_rule(Name=stop_rule_name)
        except BaseException:
            pass
        return response(
            500, {
                'error': f'Failed to create EventBridge rules: {str(e)}'})

    now = datetime.utcnow().isoformat() + 'Z'
    created_by = get_created_by(data)
    race_name = data.get('race_name') or derive_race_name(data['session_name'])
    session_item = {
        'session_id': session_id,
        'session_name': data['session_name'],
        'race_name': race_name,
        'session_type': data.get('session_type', 'RACE'),
        'timezone': session_timezone,
        'start_time': data['start_time'],
        'end_time': data['end_time'],
        'driver_ids': driver_ids,
        'driver_snapshot': driver_snapshot,
        'status': 'SCHEDULED',
        'eventbridge_start_rule': start_rule_name,
        'eventbridge_stop_rule': stop_rule_name,
        'created_by': created_by,
        'created_at': now,
        'created_date': now[:10],
        'updated_at': now
    }

    session_table.put_item(Item=session_item)

    record_audit_event('SESSION_CREATE', 'session', session_id, created_by, {
        'session_name': data['session_name'],
        'start_time': data['start_time'],
        'end_time': data['end_time'],
        'driver_ids': driver_ids
    })

    # If the newly created session is already within its active window
    # (start_time passed but end_time not reached), start immediately so
    # users don't have to refresh/wait for the next scheduler tick.
    now_utc = datetime.now(timezone.utc)
    if start_dt <= now_utc < end_dt:
        print(f"[CREATE_SESSION] Session window already active for {session_id}; starting immediately")
        start_ecs_task(session_id)

    broadcast_to_websocket_clients({
        "message_type": "session_scheduled",
        "session_id": session_id,
        "session_name": data['session_name'],
        'timezone': session_timezone,
        "start_time": data['start_time'],
        "end_time": data['end_time'],
        "action": "refresh_now"
    })

    return response(201, {
        'message': 'Session created successfully',
        'session': session_item
    })

def get_race_time_from_ui(session_id, ui_time_str):
    """
    Convert UI time (MM:SS) to real race clock time using StartedAt from DynamoDB.
    """

    result = active_sessions_table.get_item(Key={'SessionId': session_id})

    if 'Item' not in result:
        raise Exception(f"Session not found: {session_id}")

    started_at = int(result['Item']['StartedAt'])

    try:
        minutes, seconds = map(int, ui_time_str.split(':'))
    except BaseException:
        raise Exception(f"Invalid UI time format: {ui_time_str}")

    minutes, seconds = map(int, ui_time_str.split(':'))
    ui_seconds = minutes * 60 + seconds

    actual_timestamp = started_at + ui_seconds

    dt = datetime.fromtimestamp(actual_timestamp, tz=timezone.utc)

    return dt.strftime("%H:%M:%S")

def datetime_to_cron(dt):
    """Convert datetime to EventBridge cron expression.

    EventBridge cron format: cron(minutes hours day-of-month month day-of-week year)
    For one-time execution, we use specific date values.

    IMPORTANT: EventBridge cron expressions are always in UTC.
    """
    from datetime import timezone as tz

    if dt.tzinfo is not None:
        dt = dt.astimezone(tz.utc)

    print(
        f"DEBUG - datetime_to_cron: input={dt}, creating cron for {dt.hour}:{dt.minute} UTC on {dt.year}-{dt.month}-{dt.day}")

    return f"cron({dt.minute} {dt.hour} {dt.day} {dt.month} ? {dt.year})"

def list_sessions(status_filter=None):
    """List sessions, newest first.

    Optional status_filter (case-insensitive) lets the Race Sessions screen
    request just one tab's worth of data, e.g. ?status=active or
    ?status=completed. 'active' also includes SCHEDULED (upcoming) sessions so
    the Active tab shows everything that isn't finished."""

    result = session_table.scan()
    sessions = result.get('Items', [])

    for s in sessions:

        s = enrich_transcripts_with_time(s)
        s = add_schedule_columns(s)

        active = active_sessions_table.get_item(
            Key={'SessionId': s['session_id']},
            ConsistentRead=True
        )
        if 'Item' in active:

            active_item = active['Item']

            s['StartedAt'] = active_item.get('StartedAt')

            if active_item.get('Status') == 'ACTIVE':
                s['status'] = 'ACTIVE'

            elif active_item.get('Status') == 'STOPPED':
                s['status'] = 'COMPLETED'

        else:
            if s.get('status') == 'ACTIVE':
                s['status'] = 'COMPLETED'

    if status_filter:
        wanted = status_filter.strip().upper()
        if wanted == 'ACTIVE':
            allowed = {'ACTIVE', 'SCHEDULED'}
        elif wanted == 'COMPLETED':
            allowed = {'COMPLETED', 'STOPPED'}
        else:
            allowed = {wanted}
        sessions = [s for s in sessions if s.get('status') in allowed]

    sessions.sort(
        key=lambda x: x.get('start_time', ''),
        reverse=True
    )

    return response(200, {'sessions': sessions})

def get_session(session_id):
    result = session_table.get_item(Key={'session_id': session_id})
    if 'Item' not in result:
        return response(404, {'error': 'Session not found'})

    session = result['Item']

    session = enrich_transcripts_with_time(session)
    session = add_schedule_columns(session)

    return response(200, {'session': session})


