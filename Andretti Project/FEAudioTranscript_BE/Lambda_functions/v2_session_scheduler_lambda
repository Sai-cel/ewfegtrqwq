def update_session(session_id, data):
    """Update an existing session.

    Accepts drivers in any of these formats:
    - driver_ids: ["driver01", "driver02"] - lookup by driver_id (primary key)
    - driver_numbers: ["26", "10"] - lookup by car number
    - driver_names: ["Colton Herta", "Kyle Kirkwood"] - lookup by driver name
    """
    result = session_table.get_item(Key={'session_id': session_id})
    if 'Item' not in result:
        return response(404, {'error': 'Session not found'})

    existing = result['Item']

    if existing.get('status') in ['ACTIVE', 'COMPLETED']:
        return response(
            400, {
                'error': f"Cannot update session with status: {existing.get('status')}"})

    update_expr_parts = []
    expr_attr_values = {}
    expr_attr_names = {}

    simple_fields = ['session_name', 'session_type', 'timezone']
    for field in simple_fields:
        if field in data:
            update_expr_parts.append(f"#{field} = :{field}")
            expr_attr_values[f":{field}"] = data[field]
            expr_attr_names[f"#{field}"] = field

    has_driver_update = data.get('driver_ids') or data.get(
        'driver_numbers') or data.get('driver_names')
    if has_driver_update:
        resolved, error = resolve_drivers(data)
        if error:
            return error

        driver_snapshot, driver_ids = resolved
        print(
            f"Resolved {len(driver_snapshot)} drivers for update: {[d['driver_name'] for d in driver_snapshot]}")

        update_expr_parts.append("#driver_ids = :driver_ids")
        expr_attr_values[":driver_ids"] = driver_ids
        expr_attr_names["#driver_ids"] = "driver_ids"

        update_expr_parts.append("#driver_snapshot = :driver_snapshot")
        expr_attr_values[":driver_snapshot"] = driver_snapshot
        expr_attr_names["#driver_snapshot"] = "driver_snapshot"

    # FIX: resolve new_start / new_end / update_tz BEFORE the conditional, so the
    # SET clause below never references an undefined name. A PUT without
    # start_time/end_time (timezone-only edit, rename, driver change) previously
    # raised NameError: name 'new_start' is not defined -> 500.
    new_start = data.get('start_time', existing.get('start_time'))
    new_end = data.get('end_time', existing.get('end_time'))
    update_tz = data.get('timezone') or existing.get('timezone') or 'UTC'

    if 'start_time' in data or 'end_time' in data:
        start_dt = parse_session_datetime(new_start, update_tz)
        end_dt = parse_session_datetime(new_end, update_tz)

        if has_overlapping_session(start_dt, end_dt, session_id):
            return response(400, {
                'error': 'Updated session overlaps with another session'
            })
        try:
            events_client.put_rule(
                Name=existing['eventbridge_start_rule'],
                ScheduleExpression=datetime_to_cron(start_dt),
                State='ENABLED'
            )
            grant_eventbridge_invoke_permission(existing['eventbridge_start_rule'])

            events_client.put_rule(
                Name=existing['eventbridge_stop_rule'],
                ScheduleExpression=datetime_to_cron(end_dt),
                State='ENABLED'
            )
            grant_eventbridge_invoke_permission(existing['eventbridge_stop_rule'])
        except Exception as e:
            return response(
                500, {
                    'error': f'Failed to update EventBridge rules: {str(e)}'})

    update_expr_parts.append("#start_time = :start_time")
    expr_attr_values[":start_time"] = new_start
    expr_attr_names["#start_time"] = "start_time"

    update_expr_parts.append("#end_time = :end_time")
    expr_attr_values[":end_time"] = new_end
    expr_attr_names["#end_time"] = "end_time"

    if not update_expr_parts:
        return response(400, {'error': 'No valid fields to update'})

    update_expr_parts.append("#updated_at = :updated_at")
    expr_attr_values[":updated_at"] = datetime.utcnow().isoformat() + 'Z'
    expr_attr_names["#updated_at"] = "updated_at"

    session_table.update_item(
        Key={'session_id': session_id},
        UpdateExpression="SET " + ", ".join(update_expr_parts),
        ExpressionAttributeValues=expr_attr_values,
        ExpressionAttributeNames=expr_attr_names
    )

    record_audit_event('SESSION_UPDATE', 'session', session_id, get_created_by(data), {
        'updated_fields': [k.lstrip(':') for k in expr_attr_values.keys()]
    })

    # A start/end time change is a reschedule — record it distinctly with the
    # before/after window so the trail shows exactly what moved.
    if 'start_time' in data or 'end_time' in data:
        record_audit_event('SESSION_RESCHEDULE', 'session', session_id, get_created_by(data), {
            'old_start': existing.get('start_time'),
            'old_end': existing.get('end_time'),
            'new_start': new_start,
            'new_end': new_end
        })

    return get_session(session_id)


def delete_session(session_id, actor='unknown'):
    """Delete a session and its EventBridge rules."""
    result = session_table.get_item(Key={'session_id': session_id})
    if 'Item' not in result:
        return response(404, {'error': 'Session not found'})

    existing = result['Item']

    # Keep delete enabled for ACTIVE sessions by stopping resources first.
    active_row = active_sessions_table.get_item(Key={'SessionId': session_id}).get('Item') or {}
    if existing.get('status') == 'ACTIVE' or active_row.get('Status') == 'ACTIVE':
        print(f"[DELETE] Session {session_id} is ACTIVE. Stopping ECS before delete.")
        stop_result = stop_ecs_task(session_id)
        try:
            stop_code = int(stop_result.get('statusCode', 500))
        except Exception:
            stop_code = 500
        if stop_code >= 400:
            print(f"[DELETE] Failed to stop active session {session_id}: {stop_result}")
            return response(500, {'error': 'Failed to stop active session before delete'})

    try:
        start_rule = existing.get('eventbridge_start_rule')
        stop_rule = existing.get('eventbridge_stop_rule')
        if start_rule:
            events_client.remove_targets(
                Rule=start_rule,
                Ids=[f"start-{session_id}"]
            )
            events_client.delete_rule(Name=start_rule, Force=True)
        if stop_rule:
            events_client.remove_targets(
                Rule=stop_rule,
                Ids=[f"stop-{session_id}"]
            )
            events_client.delete_rule(Name=stop_rule, Force=True)
    except Exception as e:
        print(f"Warning: Error deleting EventBridge rules: {str(e)}")

    session_table.delete_item(Key={'session_id': session_id})

    try:
        active_sessions_table.delete_item(Key={'SessionId': session_id})
    except BaseException:
        pass

    record_audit_event('SESSION_DELETE', 'session', session_id, actor, {
        'session_name': existing.get('session_name')
    })

    return response(200, {'message': 'Session deleted successfully'})


def start_session_manually(session_id, actor='unknown'):
    """Manually start a session (trigger ECS)."""
    return start_ecs_task(session_id, actor=actor)


def stop_session_manually(session_id, actor='unknown'):
    """Manually stop a session (stop ECS)."""
    return stop_ecs_task(session_id, actor=actor)


def create_task_definition_revision(session_id, driver_configs):
    """
    Create a new ECS task definition revision for a specific session.

    This creates a new revision of the existing task definition family
    with SESSION_ID and driver environment variables baked in.

    Example:
    - Base: v2_req_ingester:1
    - Session 1: v2_req_ingester:2 (with SESSION_ID, DRIVER_01_URL, etc.)
    - Session 2: v2_req_ingester:3 (with different SESSION_ID, DRIVER_01_URL, etc.)
    """
    import copy

    print(f"Creating new task definition revision for session: {session_id}")

    base_task_def = ecs_client.describe_task_definition(
        taskDefinition=ECS_TASK_DEFINITION)
    task_def = base_task_def['taskDefinition']

    container_defs = copy.deepcopy(task_def['containerDefinitions'])

    for container in container_defs:
        if container['name'] == ECS_CONTAINER_NAME:
            existing_env = container.get('environment', [])

            filtered_env = [
                env for env in existing_env
                if not env['name'].startswith('SESSION_ID')
                and not env['name'].startswith('DRIVER_')
            ]

            filtered_env.append({'name': 'SESSION_ID', 'value': session_id})

            for idx, driver in enumerate(driver_configs, start=1):
                driver_prefix = f'DRIVER_{idx:02d}'
                filtered_env.append(
                    {'name': f'{driver_prefix}_URL', 'value': driver.get('stream_url', '')})
                filtered_env.append(
                    {'name': f'{driver_prefix}_NAME', 'value': driver.get('driver_name', '')})
                filtered_env.append(
                    {'name': f'{driver_prefix}_TEAM', 'value': driver.get('team', '')})

            container['environment'] = filtered_env

            driver_env_count = len(
                [e for e in filtered_env if e['name'].startswith('DRIVER_')])
            print(f"Updated container {ECS_CONTAINER_NAME}:")
            print(f"  - SESSION_ID: {session_id}")
            print(
                f"  - Driver env vars: {driver_env_count} (for {len(driver_configs)} drivers)")
            for env in filtered_env:
                if env['name'].startswith(
                        'DRIVER_') or env['name'] == 'SESSION_ID':
                    print(f"  - {env['name']}: {env['value'][:50]}...")
            break

    register_params = {
        'family': task_def['family'],
        'containerDefinitions': container_defs,
        'networkMode': task_def.get(
            'networkMode',
            'awsvpc'),
        'requiresCompatibilities': task_def.get(
            'requiresCompatibilities',
            ['FARGATE']),
        'cpu': task_def.get(
            'cpu',
            '256'),
        'memory': task_def.get(
            'memory',
            '512')}

    if task_def.get('taskRoleArn'):
        register_params['taskRoleArn'] = task_def['taskRoleArn']
    if task_def.get('executionRoleArn'):
        register_params['executionRoleArn'] = task_def['executionRoleArn']
    if task_def.get('runtimePlatform'):
        register_params['runtimePlatform'] = task_def['runtimePlatform']

    new_task_def = ecs_client.register_task_definition(**register_params)

    new_task_def_arn = new_task_def['taskDefinition']['taskDefinitionArn']
    revision = new_task_def['taskDefinition']['revision']
    print(
        f"Created new task definition revision: {task_def['family']}:{revision}")
    print(f"Task definition ARN: {new_task_def_arn}")

    return new_task_def_arn


def start_ecs_task(session_id, actor='system'):
    """
    Start ECS task for a session.

    This function:
    1. Reads the session config from v2_SessionConfig (includes driver_snapshot)
    2. Uses driver_snapshot which was saved when session was created
    3. Creates a NEW task definition revision with driver configs baked in
    4. Starts ECS Fargate task using the new revision

    Why create new revision instead of env var overrides:
    - ECS env var overrides don't work reliably in some configurations
    - Each session has its own traceable task definition revision
    - Better debugging - you can see exactly what config was used
    """
    print(f"DEBUG - Starting ECS task for session: {session_id}")
    print(f"DEBUG - ECS_CLUSTER: {ECS_CLUSTER}")
    print(f"DEBUG - ECS_TASK_DEFINITION: {ECS_TASK_DEFINITION}")
    print(f"DEBUG - ECS_SUBNETS: {ECS_SUBNETS}")
    print(f"DEBUG - ECS_SECURITY_GROUPS: {ECS_SECURITY_GROUPS}")

    result = session_table.get_item(Key={'session_id': session_id})
    if 'Item' not in result:
        print(f"Session not found: {session_id}")
        return response(404, {'error': 'Session not found'})

    session = result['Item']

    # Once a session has been completed (manually stopped, auto-stopped, or ended
    # early), it must NEVER be (re)started — not by its scheduled START trigger
    # and not by a manual call. Completed stays completed. This is what stops a
    # session that finished BEFORE its scheduled start_time from springing back
    # to life when the EventBridge START rule fires, even if another session
    # shares the same name.
    active_row = active_sessions_table.get_item(
        Key={'SessionId': session_id}).get('Item') or {}
    if session.get('status') == 'COMPLETED' or active_row.get('Status') == 'STOPPED':
        print(f"Session {session_id} already completed/stopped; not starting (actor={actor}).")
        if session.get('status') != 'COMPLETED':
            session_table.update_item(
                Key={'session_id': session_id},
                UpdateExpression="SET #status = :status",
                ExpressionAttributeNames={'#status': 'status'},
                ExpressionAttributeValues={':status': 'COMPLETED'}
            )
        return response(400, {'error': 'Session already completed; it will not restart'})

    from datetime import timezone

    now_utc = datetime.now(timezone.utc)

    # Parse end_time with the session's stored timezone, exactly as create_session
    # scheduled the EventBridge STOP rule. Using bare fromisoformat() here treated a
    # naive local end_time as UTC, so this expiry check disagreed with the schedule
    # (and could crash comparing aware-vs-naive), wrongly marking sessions COMPLETED
    # and refusing to start them before their real end time.
    end_dt = parse_session_datetime(session['end_time'], session.get('timezone'))

    if now_utc >= end_dt:
        print(f"Session {session_id} already expired. Not starting ECS.")

        session_table.update_item(
            Key={'session_id': session_id},
            UpdateExpression="SET #status = :status",
            ExpressionAttributeNames={'#status': 'status'},
            ExpressionAttributeValues={':status': 'COMPLETED'}
        )

        return response(400, {'error': 'Session already ended'})


    existing_active = get_active_session()

    if existing_active:
        return response(
            400, {
                'error': f"Another session is already ACTIVE: {existing_active['SessionId']}"})
    active_result = active_sessions_table.get_item(
        Key={'SessionId': session_id})
    if 'Item' in active_result and active_result['Item'].get(
            'Status') == 'ACTIVE':
        print(f"Session already active: {session_id}")
        return response(400, {'error': 'Session is already active'})

    driver_configs = session.get('driver_snapshot', [])

    if not driver_configs:
        print(f"No driver_snapshot found, falling back to driver table")
        for driver_id in session.get('driver_ids', []):
            driver_result = driver_table.get_item(Key={'driver_id': driver_id})
            if 'Item' in driver_result:
                driver = driver_result['Item']
                if driver.get('is_active', True):
                    driver_configs.append({
                        'driver_id': driver['driver_id'],
                        'driver_name': driver.get('driver_name', ''),
                        'driver_number': str(driver.get('driver_number', '')),
                        'team': driver.get('team', ''),
                        'stream_url': driver.get('stream_url', ''),
                        'driver_address': driver.get('driver_address', '')
                    })

    if not driver_configs:
        print(f"No active drivers found for session: {session_id}")
        return response(
            400, {
                'error': 'No active drivers configured for this session'})

    print(f"Driver configs for ECS: {json.dumps(driver_configs)}")

    try:
        new_task_def_arn = create_task_definition_revision(
            session_id, driver_configs)
    except Exception as e:
        print(f"Error creating task definition revision: {str(e)}")
        return response(
            500, {
                'error': f'Failed to create task definition: {str(e)}'})

    print(
        f"DEBUG - Starting ECS task with task definition: {new_task_def_arn}")
    try:
        subnets = [s.strip() for s in ECS_SUBNETS if s.strip()]
        security_groups = [s.strip() for s in ECS_SECURITY_GROUPS if s.strip()]
        print(f"DEBUG - Subnets: {subnets}")
        print(f"DEBUG - Security Groups: {security_groups}")

        ecs_response = ecs_client.run_task(
            cluster=ECS_CLUSTER,
            taskDefinition=new_task_def_arn,
            launchType='FARGATE',
            startedBy=session_id,
            networkConfiguration={
                'awsvpcConfiguration': {
                    'subnets': subnets,
                    'securityGroups': security_groups,
                    'assignPublicIp': 'ENABLED'
                }
            }
        )

        print(
            f"DEBUG - ECS run_task response: {json.dumps(ecs_response, default=str)}")

        task_arn = ecs_response['tasks'][0]['taskArn'] if ecs_response.get(
            'tasks') else None

        if not task_arn:
            failures = ecs_response.get('failures', [])
            raise Exception(f"Failed to start ECS task: {failures}")

        print(f"DEBUG - ECS task started successfully: {task_arn}")

    except Exception as e:
        print(f"Error starting ECS task: {str(e)}")

        active_sessions_table.put_item(Item={
            'SessionId': session_id,
            'Status': 'ERROR',
            'ErrorMessage': str(e),
            'TaskDefinitionArn': new_task_def_arn,
            'StartedAt': int(time.time())
        })

        return response(500, {'error': f'Failed to start ECS task: {str(e)}'})

    now_ts = int(time.time())
    session_table.update_item(
        Key={
            'session_id': session_id},
        UpdateExpression="SET #status = :status, #updated_at = :updated_at, #started_at = :started_at",
        ExpressionAttributeNames={
            '#status': 'status',
            '#updated_at': 'updated_at',
            '#started_at': 'started_at'},
        ExpressionAttributeValues={
            ':status': 'ACTIVE',
            ':updated_at': datetime.utcnow().isoformat() + 'Z',
            ':started_at': now_ts})

    now_ts = int(time.time())
    # Parse RaceStartAt with the session's stored timezone (same as the START/STOP
    # scheduling and the expiry check). A bare fromisoformat() left a naive
    # local time, which .timestamp() then read as UTC — drifting the race clock
    # and pre-race buffer by the offset (e.g. 5h30m for IST sessions).
    race_start_dt = parse_session_datetime(
        session['start_time'], session.get('timezone'))

    race_start_ts = int(race_start_dt.timestamp())

    active_session_item = {
        'SessionId': session_id,
        'Status': 'ACTIVE',
        'EcsTaskArns': [task_arn],
        'TaskDefinitionArn': new_task_def_arn,

        'StartedAt': now_ts,

        'RaceStartAt': race_start_ts,

        'UpdatedAt': now_ts,
        'DriverCount': len(driver_configs)
    }
    print(
        f"DEBUG - Saving to ActiveSessions: {json.dumps(active_session_item, default=str)}")
    # Upsert ACTIVE state so scheduled restarts or previously-stopped rows do
    # not fail with ConditionalCheckFailedException.
    active_sessions_table.put_item(Item=active_session_item)
    print(f"DEBUG - Successfully upserted ActiveSessions table")

    record_audit_event('SESSION_START', 'session', session_id, actor, {
        'task_arn': task_arn,
        'driver_count': len(driver_configs)
    })

    broadcast_to_websocket_clients({
        "message_type": "session_started",
        "session_id": session_id,
        "started_at": now_ts,
        "race_start_at": race_start_ts,
        "action": "refresh_now",
        "should_refresh_page": True,
        "trigger": "auto_or_manual_start"
    })

    return response(200, {
        'message': 'ECS task started successfully',
        'session_id': session_id,
        'task_arn': task_arn,
        'task_definition_arn': new_task_def_arn,
        'driver_count': len(driver_configs),
        'drivers': [d['driver_name'] for d in driver_configs]
    })


def stop_ecs_task(session_id, actor='system'):
    """Stop ECS task for a session."""
    print(f"Stopping ECS task for session: {session_id}")

    session_result = session_table.get_item(Key={'session_id': session_id})
    if 'Item' in session_result:
        session = session_result['Item']
        # Use the session's stored timezone (same as scheduling) so this check is
        # tz-aware and consistent; bare fromisoformat() misread naive local times.
        end_dt = parse_session_datetime(session['end_time'], session.get('timezone'))

        now_utc = datetime.now(timezone.utc)

        if now_utc < end_dt:
            print("WARNING: Stop called before session end_time")

    try:
        scan_result = active_sessions_table.scan(Limit=10)
        print(f"DEBUG - Active sessions in table ({ACTIVE_SESSIONS_TABLE}):")
        for item in scan_result.get('Items', []):
            print(
                f"  - SessionId: {item.get('SessionId')}, Status: {item.get('Status')}")
        if not scan_result.get('Items'):
            print("  - (table is empty)")
    except Exception as e:
        print(f"DEBUG - Error scanning active sessions table: {e}")

    print(
        f"DEBUG - Looking up SessionId: '{session_id}' in table: {ACTIVE_SESSIONS_TABLE}")
    active_result = active_sessions_table.get_item(
        Key={'SessionId': session_id})
    print(
        f"DEBUG - Lookup result: {json.dumps(active_result, cls=DecimalEncoder)}")

    if 'Item' not in active_result:
        print(f"No active session found: {session_id}")
        session_table.update_item(
            Key={
                'session_id': session_id},
            UpdateExpression="SET #status = :status, #updated_at = :updated_at",
            ExpressionAttributeNames={
                '#status': 'status',
                '#updated_at': 'updated_at'},
            ExpressionAttributeValues={
                ':status': 'COMPLETED',
                ':updated_at': datetime.utcnow().isoformat() + 'Z'})
        record_audit_event('SESSION_STOP', 'session', session_id, actor, {
            'note': 'no active task found; marked completed'})
        return response(
            200, {
                'message': 'Session marked as completed (no active task found)'})

    active_session = active_result['Item']



    task_arns = active_session.get('EcsTaskArns', [])

    for task in task_arns:
        try:
            ecs_client.stop_task(
                cluster=ECS_CLUSTER,
                task=task,
                reason=f'Session {session_id} ended'
            )
            print(f"ECS task stopped: {task}")
        except Exception as e:
            print(f"Error stopping ECS task {task}: {str(e)}")
    print(f"DEBUG - Updating session status in {SESSION_TABLE}")

    try:
        session_table.update_item(
            Key={
                'session_id': session_id},
            UpdateExpression="SET #status = :status, #updated_at = :updated_at",
            ExpressionAttributeNames={
                '#status': 'status',
                '#updated_at': 'updated_at'},
            ExpressionAttributeValues={
                ':status': 'COMPLETED',
                ':updated_at': datetime.utcnow().isoformat() + 'Z'})

        print(
            f"DEBUG - Session status updated to COMPLETED in {SESSION_TABLE}")

    except Exception as e:
        print(f"DEBUG - Error updating session status: {str(e)}")


    print(f"DEBUG - Updating active session status in {ACTIVE_SESSIONS_TABLE}")

    try:
        now_ts = int(time.time())

        active_sessions_table.update_item(
            Key={'SessionId': session_id},
            UpdateExpression="SET #status = :status, #stopped_at = :stopped_at, #updated_at = :updated_at",
            ExpressionAttributeNames={
                '#status': 'Status',
                '#stopped_at': 'StoppedAt',
                '#updated_at': 'UpdatedAt'
            },
            ExpressionAttributeValues={
                ':status': 'STOPPED',
                ':stopped_at': now_ts,
                ':updated_at': now_ts
            }
        )

        print(f"DEBUG - Active session status updated to STOPPED")

    except Exception as e:
        print(f"DEBUG - Error updating active session: {str(e)}")


    print(f"DEBUG - Disabling EventBridge rules")
    try:
        session_result = session_table.get_item(Key={'session_id': session_id})
        if 'Item' in session_result:
            session = session_result['Item']
            if session.get('eventbridge_start_rule'):

                events_client.remove_targets(
                    Rule=session['eventbridge_start_rule'],
                    Ids=[f"start-{session_id}"]
                )

                events_client.delete_rule(
                    Name=session['eventbridge_start_rule'],
                    Force=True
                )
                print(
                    f"DEBUG - Disabled start rule: {session['eventbridge_start_rule']}")
            if session.get('eventbridge_stop_rule'):
                try:
                    events_client.remove_targets(
                        Rule=session['eventbridge_stop_rule'],
                        Ids=[f"stop-{session_id}"]
                    )
                except Exception as e:
                    print(f"DEBUG - remove_targets on stop rule failed (continuing): {e}")
                events_client.delete_rule(
                    Name=session['eventbridge_stop_rule'],
                    Force=True
                )
                print(
                    f"DEBUG - Disabled stop rule: {session['eventbridge_stop_rule']}")
        else:
            print(
                f"DEBUG - No session found in {SESSION_TABLE} for EventBridge rule cleanup")
    except Exception as e:
        print(f"Warning: Error disabling EventBridge rules: {str(e)}")

    # REMOVED (2026-08-19): live sessions do NOT need v2_audio_merge_lambda.
    # Fargate's ingester.py already writes the complete, reliable full-race
    # recording directly to full-race-recordings/{session_id}/{driver}/full_session.mp3
    # for every driver, as soon as the container shuts down. Verified via
    # CloudShell against a real race (20 drivers): the merge Lambda's live
    # output only had 4/20 drivers even though it logged AUDIO_MERGE_SUCCESS -
    # i.e. it was silently incomplete and redundant. The upload flow's merge
    # call (check_stale_upload_sessions, which sends "flow": "upload") is
    # UNCHANGED - uploads still need it, since Fargate never touches uploads.
    print(f"DEBUG - Skipping audio merge for live session {session_id}; "
          f"Fargate already wrote the full recording directly.")

    print(
        f"DEBUG - Stop function completed successfully for session: {session_id}")

    record_audit_event('SESSION_STOP', 'session', session_id, actor, {
        'task_arns': task_arns
    })

    broadcast_to_websocket_clients({
        "message_type": "session_stopped",
        "session_id": session_id,
        "stopped_at": int(time.time()),
        "grace_period_seconds": 120,
        "action": "refresh_after",
        "refresh_after_seconds": 120
    })

    return response(200, {
        'message': 'ECS task stopped successfully',
        'session_id': session_id
    })


def response(status_code, body):
    """Create API Gateway response."""
    return {
        'statusCode': status_code,
        'headers': {
            'Content-Type': 'application/json',
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Headers': 'Content-Type,Authorization',
            'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS'
        },
        'body': json.dumps(body, cls=DecimalEncoder)
    }


def find_overlapping_session_name(start_dt, end_dt, exclude_session_id=None):
    """Return the session_name of the first SCHEDULED/ACTIVE session whose
    time window overlaps [start_dt, end_dt), or None if no conflict.

    Returning the name (not just a bool) lets the API surface the specific
    conflicting session in the validation message."""
    result = session_table.scan()
    sessions = result.get('Items', [])

    for session in sessions:
        if exclude_session_id and session['session_id'] == exclude_session_id:
            continue

        if session.get('status') in ['COMPLETED', 'STOPPED']:
            continue

        existing_start = datetime.fromisoformat(
            session['start_time'].replace('Z', '+00:00')
        )
        existing_end = datetime.fromisoformat(
            session['end_time'].replace('Z', '+00:00')
        )

        if start_dt < existing_end and end_dt > existing_start:
            return session.get('session_name') or session.get('session_id')

    return None


def has_overlapping_session(start_dt, end_dt, exclude_session_id=None):
    """Backwards-compatible boolean wrapper around find_overlapping_session_name."""
    return find_overlapping_session_name(start_dt, end_dt, exclude_session_id) is not None


def find_session_name_conflict(session_name, exclude_session_id=None):
    """Return the session_id of a non-completed session that already uses
    this name (case-insensitive, trimmed), or None if the name is free.
    Completed/Stopped sessions are ignored so names can be reused historically."""
    if not session_name:
        return None
    target = str(session_name).strip().lower()
    if not target:
        return None

    result = session_table.scan()
    for session in result.get('Items', []):
        if exclude_session_id and session.get('session_id') == exclude_session_id:
            continue
        if session.get('status') in ['COMPLETED', 'STOPPED']:
            continue
        existing = str(session.get('session_name', '')).strip().lower()
        if existing and existing == target:
            return session.get('session_id')
    return None


