def broadcast_to_websocket_clients(payload):
    """Push a message to every active WebSocket dashboard client so the UI can
    refresh in response to session state changes.

    Used for:
      - session_scheduled  -> a new session was just created; refresh immediately
      - session_started    -> auto or manual start; refresh to show live data
      - session_stopped    -> session ended; refresh after grace_period_seconds

    No-op if WEBSOCKET_ENDPOINT env var is not configured."""
    try:
        conn_table = dynamodb.Table(CONNECTIONS_TABLE)
        connections = conn_table.scan().get('Items', [])
    except Exception as e:
        print(f"[WS_BROADCAST] Could not list connections: {e}")
        return
    if not connections:
        print(f"[WS_BROADCAST] No active connections; skipping {payload.get('message_type')}")
        return

    body = json.dumps(payload).encode('utf-8')
    sent = 0
    clients_by_endpoint = {}
    for conn in connections:
        cid = conn.get('connectionId')
        if not cid:
            continue
        endpoint = WEBSOCKET_ENDPOINT
        if not endpoint:
            dn = conn.get('domainName')
            st = conn.get('stage')
            if dn and st:
                endpoint = f"https://{dn}/{st}"
            else:
                print(f"[WS_BROADCAST] Missing endpoint metadata for {cid}; skipping")
                continue
        apigw = clients_by_endpoint.get(endpoint)
        if apigw is None:
            try:
                apigw = boto3.client('apigatewaymanagementapi', endpoint_url=endpoint)
                clients_by_endpoint[endpoint] = apigw
            except Exception as e:
                print(f"[WS_BROADCAST] Could not create apigateway client for {endpoint}: {e}")
                continue
        try:
            apigw.post_to_connection(ConnectionId=cid, Data=body)
            sent += 1
        except Exception as e:
            err_code = getattr(e, 'response', {}).get('Error', {}).get('Code', '')
            if err_code in ('GoneException', 'ForbiddenException', 'BadRequestException'):
                try:
                    conn_table.delete_item(Key={'connectionId': cid})
                except Exception:
                    pass
            else:
                print(f"[WS_BROADCAST] post failed for {cid}: {e}")
    print(f"[WS_BROADCAST] {payload.get('message_type')} pushed to {sent}/{len(connections)} clients")


def grant_eventbridge_invoke_permission(rule_name):
    """Grant the EventBridge rule permission to invoke this Lambda.

    Without this, put_rule + put_targets succeed but the scheduled event
    never actually fires the Lambda — sessions silently fail to auto-start
    at their start_time. ResourceConflictException means the permission
    already exists (e.g. the rule was recreated), which is fine."""
    if not SCHEDULER_LAMBDA_ARN:
        print(f"[PERMISSION] SCHEDULER_LAMBDA_ARN not set; cannot grant invoke for rule '{rule_name}'")
        return
    try:
        rule_arn = events_client.describe_rule(Name=rule_name)['Arn']
    except Exception as e:
        print(f"[PERMISSION] Could not describe rule '{rule_name}' to get ARN: {e}")
        return
    try:
        lambda_client.add_permission(
            FunctionName=SCHEDULER_LAMBDA_ARN,
            StatementId=f'eb-{rule_name}'[:100],
            Action='lambda:InvokeFunction',
            Principal='events.amazonaws.com',
            SourceArn=rule_arn
        )
        print(f"[PERMISSION] Granted EventBridge invoke for rule '{rule_name}'")
    except lambda_client.exceptions.ResourceConflictException:
        print(f"[PERMISSION] Invoke permission already exists for rule '{rule_name}'")
    except Exception as e:
        print(f"[PERMISSION] Failed to add permission for rule '{rule_name}': {e}")

