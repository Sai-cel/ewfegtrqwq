def enrich_transcripts_with_time(session):
    """
    Updates the transcripts of a session to include display_time.
    display_time is HH:MM:SS relative to the scheduled race start_time.
    Transcripts that occur before race start are prefixed with '-' (e.g. '-00:15:00').
    """
    transcripts = session.get("transcripts", [])
    if not transcripts:
        return session

    session_id = session['session_id']
    started_at = None
    started_at_source = None

    session_started_at = session.get('started_at')
    if session_started_at:
        try:
            started_at = int(session_started_at)
            started_at_source = "session.started_at"
        except (TypeError, ValueError):
            started_at = None

    if started_at is None:
        try:
            active = active_sessions_table.get_item(
                Key={'SessionId': session_id},
                ConsistentRead=True
            )
            if 'Item' in active and active['Item'].get('StartedAt'):
                started_at = int(active['Item']['StartedAt'])
                started_at_source = "active.StartedAt"
        except Exception as e:
            print(f"DEBUG - active table lookup failed for {session_id}: {e}")

    try:
        race_start_ts = int(
            datetime.fromisoformat(
                session['start_time'].replace('Z', '+00:00')
            ).timestamp()
        )
    except (KeyError, ValueError, AttributeError, TypeError) as e:
        print(f"DEBUG - Could not parse session.start_time ({e}); display_time will be relative to started_at")
        race_start_ts = started_at

    if started_at is None:
        started_at = race_start_ts
        started_at_source = "start_time fallback"

    print(f"DEBUG - started_at={started_at} (source={started_at_source}), race_start_ts={race_start_ts}, session={session_id}")

    def parse_offset(offset_val):
        """Return total seconds (int) for MM:SS or HH:MM:SS, or None if missing/unparseable."""
        if offset_val is None or offset_val == "":
            return None
        try:
            parts = list(map(int, str(offset_val).split(":")))
        except (ValueError, AttributeError):
            return None
        if len(parts) == 2:
            return parts[0] * 60 + parts[1]
        if len(parts) == 3:
            return parts[0] * 3600 + parts[1] * 60 + parts[2]
        return None

    parsed_seconds = [parse_offset(t.get("offset")) for t in transcripts]

    missing_idx = [i for i, s in enumerate(parsed_seconds) if s is None]
    if missing_idx:
        print(
            f"DEBUG - {len(missing_idx)}/{len(transcripts)} transcripts missing/unparseable offset "
            f"for session {session_id}; indices={missing_idx[:20]}"
            f"{'...' if len(missing_idx) > 20 else ''}")

    for i in range(len(parsed_seconds) - 2, -1, -1):
        if parsed_seconds[i] is None and parsed_seconds[i + 1] is not None:
            parsed_seconds[i] = parsed_seconds[i + 1]

    for i in range(1, len(parsed_seconds)):
        if parsed_seconds[i] is None and parsed_seconds[i - 1] is not None:
            parsed_seconds[i] = parsed_seconds[i - 1]

    formatted = []
    for t, total_seconds in zip(transcripts, parsed_seconds):
        display = "00:00"
        delta_val = None
        try:
            if total_seconds is not None:
                actual_ts = started_at + total_seconds
                delta = actual_ts - race_start_ts
                delta_val = delta
                sign = "-" if delta < 0 else ""
                abs_delta = abs(delta)
                hours = abs_delta // 3600
                minutes = (abs_delta % 3600) // 60
                seconds = abs_delta % 60
                if hours > 0:
                    display = f"{sign}{hours:02d}:{minutes:02d}:{seconds:02d}"
                else:
                    display = f"{sign}{minutes:02d}:{seconds:02d}"
        except Exception as e:
            print(f"Error calculating display_time: {e}")

        formatted.append({
            **t,
            "display_time": display,
            "display_time_seconds": delta_val
        })

    # Show the conversation in ascending race-time order. For a manually-started
    # session the pre-race audio yields negative times; sorting numerically keeps
    # them first (-MM:SS) and crossing 00:00 into positive times, instead of
    # ordering by the raw offset or string. Transcripts whose offset could not be
    # parsed keep their original relative order at the end.
    formatted.sort(key=lambda x: (x.get("display_time_seconds") is None,
                                  x.get("display_time_seconds") or 0))

    session["transcripts"] = formatted
    return session

