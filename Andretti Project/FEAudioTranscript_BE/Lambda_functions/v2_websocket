def record_audit_event(action, entity, entity_id, created_by, details=None):
    """Write an audit-trail record to S3 in three places: a date partition
    (unchanged), session_logs/{session_id}/ for session-scoped events
    (WEBSOCKET_SEARCH, entity='pipeline'), or system_logs/YYYY/MM/DD/ for
    everything else (connect/disconnect/error, entity='websocket', keyed by
    connection_id). No-op if AUDIT_S3_BUCKET is unset; never raises."""
    if not AUDIT_S3_BUCKET:
        return
    try:
        now = datetime.utcnow()
        record = {
            'audit_id': str(uuid.uuid4()),
            'timestamp': now.isoformat() + 'Z',
            'action': action,
            'entity': entity,
            'entity_id': str(entity_id) if entity_id is not None else '',
            'created_by': created_by or 'unknown',
            'details': details or {}
        }
        suffix = f"{action}_{int(now.timestamp())}_{record['audit_id'][:8]}.json"
        body = json.dumps(record, default=str).encode('utf-8')
        date_path = now.strftime('%Y/%m/%d')
        audit_s3.put_object(
            Bucket=AUDIT_S3_BUCKET,
            Key=f"{AUDIT_S3_PREFIX}{date_path}/{suffix}",
            Body=body,
            ContentType='application/json'
        )
        if entity in SESSION_SCOPED_ENTITIES and record['entity_id']:
            audit_s3.put_object(
                Bucket=AUDIT_S3_BUCKET,
                Key=f"{SESSION_LOGS_PREFIX}{record['entity_id']}/{suffix}",
                Body=body,
                ContentType='application/json'
            )
        else:
            audit_s3.put_object(
                Bucket=AUDIT_S3_BUCKET,
                Key=f"{SYSTEM_LOGS_PREFIX}{date_path}/{suffix}",
                Body=body,
                ContentType='application/json'
            )
    except Exception as e:
        print(f"[AUDIT] Failed to record {action} for {entity}:{entity_id}: {e}")
def get_latest_session_from_opensearch():
    """Fallback: Get the most recent SessionId from OpenSearch"""
    try:
        credentials = base64.b64encode(f"{USERNAME}:{PASSWORD}".encode()).decode()
        url = f"{OPENSEARCH_URL}/{INDEX_NAME}/_search"
        payload = {
            "size": 1,
            "sort": [{"Timestamp": {"order": "desc"}}],
            "_source": ["SessionId"]
        }
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode(),
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Basic {credentials}"
            },
            method="POST"
        )
        res = urllib.request.urlopen(req)
        data = json.loads(res.read().decode())
        hits = data.get("hits", {}).get("hits", [])
        if hits:
            return hits[0].get("_source", {}).get("SessionId")
        return None
    except Exception as e:
        print(f"[SESSION_CHECK] OpenSearch fallback error: {e}")
        return None
def get_valid_session_for_display():
    """
    Get a valid session for display based on ECS status and grace period.
    Logic:
    - If Status = ACTIVE → return session (ECS is running)
    - If Status = STOPPED and within grace period → return session
    - If Status = STOPPED and grace period expired → fallback to OpenSearch
    - If no ActiveSessions entry → fallback to latest from OpenSearch
    Always returns a session ID if any transcriptions exist in OpenSearch.
    """
    try:
        response = active_sessions_table.scan()
        sessions = response.get('Items', [])
        if not sessions:
            print("[SESSION_CHECK] No sessions in v2_ActiveSessions table - fallback to OpenSearch")
            return get_latest_session_from_opensearch()
        latest_session = max(sessions, key=lambda x: int(x.get('UpdatedAt', 0)))
        session_id = latest_session.get('SessionId')
        status = latest_session.get('Status')
        print(f"[SESSION_CHECK] Session: {session_id}, Status: {status}")
        if status == 'ACTIVE':
            print(f"[SESSION_CHECK] Session {session_id} is ACTIVE - valid")
            return session_id
        if status == 'STOPPED':
            stopped_at = int(latest_session.get('StoppedAt', 0))
            current_time = int(time.time())
            time_since_stopped = current_time - stopped_at
            grace_period_seconds = SESSION_GRACE_PERIOD_MINUTES * 60
            print(f"[SESSION_CHECK] StoppedAt: {stopped_at}")
            print(f"[SESSION_CHECK] Time since stopped: {time_since_stopped} seconds")
            if time_since_stopped <= grace_period_seconds:
                remaining = grace_period_seconds - time_since_stopped
                print(f"[SESSION_CHECK] Within grace period - {remaining} seconds remaining")
                return session_id
            else:
                print(f"[SESSION_CHECK] Grace period expired - returning None to stop display")
                return None
        return get_latest_session_from_opensearch()
    except Exception as e:
        print(f"[SESSION_CHECK] Error: {e}")
        traceback.print_exc()
        return get_latest_session_from_opensearch()
def _extract_chunk_key_from_audio_path(audio_s3_path):
    """From a stored audio_s3_path (raw s3:// URI, presigned URL, or even a
    malformed s3://bucket/https://... string), return (driver_folder, source_file)
    by locating the silence-removed/ marker and taking the path tail.
    Returns (None, None) if the path doesn't include the marker."""
    if not audio_s3_path:
        return (None, None)
    s = str(audio_s3_path).split('?')[0]
    idx = s.rfind(SILENCE_REMOVED_PREFIX)
    if idx == -1:
        return (None, None)
    tail = s[idx + len(SILENCE_REMOVED_PREFIX):]
    parts = tail.split('/')
    if len(parts) >= 3:
        return (parts[1], parts[2])
    if len(parts) >= 2:
        return (parts[0], parts[1])
    return (None, None)
def get_relevant_message_lookup(session_id):
    """Build two lookups for relevant messages in this session. Two keys so the
    match works even if the frontend posted a malformed audio_s3_key:
      lookup_by_file: (driver_folder, source_file) -> message_id
      lookup_by_time: (driver_name,  time_string)  -> message_id
    The search handler checks both and uses whichever hits first."""
    if not session_id:
        return {}, {}
    try:
        rm_table = dynamodb.Table(RELEVANT_MESSAGES_TABLE)
        resp = rm_table.query(
            KeyConditionExpression=Key('SessionId').eq(session_id),
            ConsistentRead=True
        )
        items = resp.get('Items', [])
    except Exception as e:
        print(f"[REL_LOOKUP] Error querying {RELEVANT_MESSAGES_TABLE}: {e}")
        return {}, {}
    lookup_by_file = {}
    lookup_by_time = {}
    for item in items:
        if item.get('is_relevant') is False:
            continue
        msg_id = item.get('MessageId')
        driver_name = item.get('driver')
        time_str = item.get('time')
        if driver_name and time_str:
            lookup_by_time[(str(driver_name), str(time_str))] = msg_id
        stored_driver_id = item.get('driver_id')
        stored_source_file = item.get('source_file')
        if stored_driver_id and stored_source_file:
            lookup_by_file[(str(stored_driver_id), str(stored_source_file))] = msg_id
        parsed_driver, parsed_file = _extract_chunk_key_from_audio_path(item.get('audio_s3_path'))
        if parsed_driver and parsed_file and (parsed_driver, parsed_file) not in lookup_by_file:
            lookup_by_file[(parsed_driver, parsed_file)] = msg_id
        print(f"[REL_LOOKUP] item MessageId={msg_id} driver='{driver_name}' driver_id='{stored_driver_id}' "
              f"source_file='{stored_source_file}' time='{time_str}' audio_path='{item.get('audio_s3_path')}' "
              f"parsed=({parsed_driver}, {parsed_file})")
    print(f"[REL_LOOKUP] Built {len(lookup_by_file)} by-file + {len(lookup_by_time)} by-time entries for session {session_id}")
    return lookup_by_file, lookup_by_time
